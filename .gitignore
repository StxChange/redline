# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Visual Studio Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db

# Python virtual env
env/
venv/
.venv/

# Logs
*.log

# Editor swap files
*.swp

# Secrets
.env

# Large or user data files - do not commit
*.xlsx
dist/*.exe
assets/video_web.mp4
assets/video_*_orig.*

# Node modules (if any)
node_modules/

# Git LFS pointer files (if using LFS)
*.lfs
